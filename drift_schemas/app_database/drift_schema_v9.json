  "fixed_sql": [
    {
      "name": "tasks",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"tasks\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"title\" TEXT NOT NULL, \"notes\" TEXT NULL, \"type\" TEXT NOT NULL, \"difficulty\" TEXT NOT NULL, \"element\" TEXT NULL, \"habit_up\" INTEGER NOT NULL DEFAULT 1 CHECK (\"habit_up\" IN (0, 1)), \"habit_down\" INTEGER NOT NULL DEFAULT 0 CHECK (\"habit_down\" IN (0, 1)), \"daily_target\" INTEGER NOT NULL DEFAULT 1, \"repeat_days\" INTEGER NOT NULL DEFAULT 127, \"reminder_minutes\" INTEGER NULL, \"cost\" INTEGER NOT NULL DEFAULT 0, \"value\" REAL NOT NULL DEFAULT 0.0, \"streak\" INTEGER NOT NULL DEFAULT 0, \"completed\" INTEGER NOT NULL DEFAULT 0 CHECK (\"completed\" IN (0, 1)), \"archived\" INTEGER NOT NULL DEFAULT 0 CHECK (\"archived\" IN (0, 1)), \"sort_order\" INTEGER NOT NULL DEFAULT 0, \"created_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)));"
        }
      ]
    },
    {
      "name": "task_logs",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"task_logs\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"task_id\" INTEGER NOT NULL, \"kind\" TEXT NOT NULL, \"value_delta\" REAL NOT NULL DEFAULT 0.0, \"coins_delta\" INTEGER NOT NULL DEFAULT 0, \"streak_delta\" INTEGER NOT NULL DEFAULT 0, \"critical\" INTEGER NOT NULL DEFAULT 0 CHECK (\"critical\" IN (0, 1)), \"created_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), \"title\" TEXT NULL, \"element\" TEXT NULL, \"drop_item\" TEXT NULL, \"drop_count\" INTEGER NOT NULL DEFAULT 0);"
        }
      ]
    },
    {
      "name": "profiles",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"profiles\" (\"id\" INTEGER NOT NULL, \"coins\" INTEGER NOT NULL DEFAULT 0, \"day_start_hour\" INTEGER NOT NULL DEFAULT 0, \"resting\" INTEGER NOT NULL DEFAULT 0 CHECK (\"resting\" IN (0, 1)), \"last_rollover_date\" INTEGER NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "pets",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"pets\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL, \"exp\" INTEGER NOT NULL DEFAULT 0, \"fire_points\" INTEGER NOT NULL DEFAULT 0, \"water_points\" INTEGER NOT NULL DEFAULT 0, \"wood_points\" INTEGER NOT NULL DEFAULT 0, \"branch\" TEXT NULL, \"evolved_at\" INTEGER NULL);"
        }
      ]
    },
    {
      "name": "inventory_items",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"inventory_items\" (\"item\" TEXT NOT NULL, \"count\" INTEGER NOT NULL DEFAULT 0, PRIMARY KEY (\"item\"));"
        }
      ]
    }
  ]
